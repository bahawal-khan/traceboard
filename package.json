{
  "name": "traceboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:setup-roles": "node scripts/setup-roles.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node scripts/seed-prices.mjs",
    "measure:rows": "node scripts/measure-event-size.mjs",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:db:timed": "node scripts/test-db.mjs all --timing",
    "test:db:ingest": "node scripts/test-db.mjs ingest",
    "test:db:security": "node scripts/test-db.mjs security",
    "test:db:control": "node scripts/test-db.mjs control",
    "test:db:jobs": "node scripts/test-db.mjs jobs",
    "test:db:metrics": "node scripts/test-db.mjs metrics",
    "test:db:traces": "node scripts/test-db.mjs traces",
    "db:ping": "node scripts/db-ping.mjs",
    "demo:snapshot": "UPDATE_DEMO_SNAPSHOT=1 vitest run --project unit tests/demo-snapshot.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/nextjs": "7.10.3",
    "@neondatabase/serverless": "1.2.1",
    "@tanstack/react-virtual": "3.14.26",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.8.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "description": "TraceBoard: observability and trustworthy evaluation for LLM apps and agents",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  }
}
