# Copy to .env.local. Never commit real values.
DATABASE_URL=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CRON_SECRET=
JOB_HMAC_SECRET=
PROVIDER_KEY_MASTER_KEY=
MAX_USERS=10
DEMO_SOURCE=static
# Optional
MIGRATION_DATABASE_URL=
NEON_API_KEY=
PORTFOLIO_ORIGIN=
RESEND_API_KEY=
# Clerk routes (public, not secret)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# One-time DB setup (never in Vercel): run `npm run db:setup-roles` once per Neon branch.
# ADMIN_DATABASE_URL = the Neon owner role, DIRECT (non-pooled) host.
# DATABASE_URL = app_rw on the POOLED host. MIGRATION_DATABASE_URL = migrator on the DIRECT host.
ADMIN_DATABASE_URL=
APP_RW_PASSWORD=
MIGRATOR_PASSWORD=
